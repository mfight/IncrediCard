{
  "name": "incredicard",
  "version": "0.1.0",
  "description": "A credit-card entry form for React with a dimensional card that mirrors what's typed, built on real, accessible fields.",
  "license": "Apache-2.0",
  "homepage": "https://incredicard.markfight.com/",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfight/IncrediCard.git"
  },
  "keywords": [
    "react",
    "credit-card",
    "payment-form",
    "accessibility",
    "skeuomorphic"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/incredicard.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "lint:refs": "node scripts/check-react-hooks-refs.mjs",
    "check:american-english": "node scripts/check-american-english.mjs",
    "test": "vitest run",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:consumer": "node scripts/test-consumer.mjs",
    "storybook": "storybook dev -p ${PORT:-6006}",
    "build-storybook": "storybook build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.0",
    "globals": "16.4.0",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "4.0.1",
    "sass": "1.101.0",
    "storybook": "10.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "axe-core": "4.12.1"
  }
}
